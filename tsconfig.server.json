{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist/server",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/server",
    "src/engine",
    "src/box"
  ]
}
